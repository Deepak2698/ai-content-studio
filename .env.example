# Content Engine settings. Copy this file to ".env" and fill in the values YOU own.
# Never share .env or commit it. Lines starting with # are ignored.

# --- AI script writer (ChatGPT or Claude) ------------------------------------------
# Fill in ONE of the two keys. Leave both blank and the worker skips rows that need an
# AI-written script (rows that already have a script still work).
# Note: a ChatGPT Plus subscription does NOT include API use. The key comes from
# https://platform.openai.com/api-keys and is billed separately (pay as you go).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Claude key: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# auto = use whichever key is filled in (ChatGPT first if both are). Or: openai / claude
SCRIPT_WRITER=auto

# --- Content calendar ------------------------------------------------------------
# "local" = templates/content_calendar.csv (works today, no setup)
# "google" = a Google Sheet (see docs/GOOGLE_SHEETS_SETUP.md)
SHEET_BACKEND=local
LOCAL_SHEET_PATH=calendar.csv
# Google Sheet ID = the long part of the sheet's URL between /d/ and /edit
GOOGLE_SHEET_ID=
# Tab name inside the sheet
GOOGLE_SHEET_TAB=Calendar
# Path to the service-account JSON key you downloaded (keep it in credentials/)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# --- Render engine -----------------------------------------------------------------
# Folder of AI Creator Studio (voice clone + lip-sync)
STUDIO_DIR=../ai-creator-studio

# --- Free stock b-roll (optional) ----------------------------------------------------
# https://www.pexels.com/api/  and/or  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Publishing (OFF by default) -----------------------------------------------------
# Finished reels always go to ready/. Auto-posting only happens when AUTO_POST=true
# AND the platform is enabled AND its credentials are filled in.
AUTO_POST=false
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Instagram needs the video at a public https URL. Put your public base URL here
# (for example a Cloudflare R2 / S3 bucket that you upload ready/ files to).
PUBLIC_MEDIA_BASE_URL=
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube-token.json
BUFFER_ENABLED=false
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=
